# SQLite file used by SQLAlchemy (default is fine for local dev)
DATABASE_URL=sqlite:///./pinterest_clone.db

# Secret used to sign JWTs — set this to a long random string in your local .env
JWT_SECRET_KEY=change-this-to-a-long-random-string

# Extra allowed frontend origins (comma-separated), e.g. your Netlify URL
CORS_ORIGINS=
